# Research and outreach deliberately override the cheap default: chain mapping
# and a first approach to a real buyer are the two places where a weaker model
# produces work that is worse than none.
OPENAI_RESEARCH_MODEL=gpt-4.1
OPENAI_OUTREACH_MODEL=gpt-4.1

# WhatsApp Cloud API pilot. Names only — set the values in Vercel, never in chat.
